{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "${OIDC_PROVIDER_ARN}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${OIDC_PROVIDER_HOST}:aud": "sts.amazonaws.com",
          "${OIDC_PROVIDER_HOST}:sub": "system:serviceaccount:${K8S_NAMESPACE}:${APP_SERVICE_ACCOUNT}"
        }
      }
    }
  ]
}
