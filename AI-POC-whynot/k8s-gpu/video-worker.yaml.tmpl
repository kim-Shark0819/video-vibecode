# GPU 영상 워커.
#
# ## replicas: 1 인 이유
#
# 노드그룹 max 가 1이고(V-13 동시 처리 목표 미정), GPU 1장을 여러 파드가 나눠 쓸 수
# 없다. 동시 처리 목표가 정해지면 노드그룹 max 와 함께 올린다.
#
# ## Recreate 전략인 이유
#
# RollingUpdate 는 새 파드가 뜰 때까지 옛 파드를 유지한다. GPU 1장뿐이라 새 파드가
# `nvidia.com/gpu: 1` 을 요청해도 옛 파드가 이미 그 1장을 쥐고 있어 영원히 Pending
# 이 된다. Recreate 는 옛 파드를 먼저 내린다.
#
# ## /dev/shm 크기
#
# g6e.xlarge 는 RAM 32GiB 뿐이다. 원본 시스템의 16Gi 를 그대로 쓰면 호스트 RAM의
# 절반이 날아간다. 8Gi 로 줄인다.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${PROJECT_NAME}-video-worker
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: video-worker
    app.kubernetes.io/component: video-inference
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: video-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: video-worker
        app.kubernetes.io/component: video-inference
        app.kubernetes.io/part-of: ${PROJECT_NAME}
    spec:
      serviceAccountName: video-worker
      terminationGracePeriodSeconds: 60
      nodeSelector:
        ${GPU_NODE_LABEL_KEY}: ${GPU_NODE_LABEL_VALUE}
      tolerations:
        - key: nvidia.com/gpu
          operator: Equal
          value: "true"
          effect: NoSchedule
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: worker
          image: ${VIDEO_WORKER_IMAGE}
          imagePullPolicy: Always
          env:
            - name: WEIGHTS_DIR
              value: /weights
            - name: WAN_MODEL_DIR
              value: ${WAN_MODEL_DIR}
            - name: WAN_TASK
              value: i2v-A14B
            - name: WAN_GPUS
              value: "1"
            - name: WAN_DEFAULT_SIZE
              value: "832*480"
            - name: WAN_DEFAULT_STEPS
              value: "40"
            - name: WAN_DEFAULT_FRAMES
              value: "81"
            - name: WAN_JOB_TIMEOUT_SECONDS
              value: "5400"
            - name: QUEUE_CLIP_URL
              value: ${VIDEO_CLIP_QUEUE_URL}
            - name: AWS_REGION
              value: ${AWS_REGION}
            - name: S3_BUCKET
              value: ${S3_BUCKET}
            - name: GPU_INSTANCE_TYPE
              value: g6e.xlarge
            - name: GPU_HOURLY_USD
              value: "2.288"
          resources:
            limits:
              nvidia.com/gpu: "1"
              cpu: "3"
              memory: 26Gi
            requests:
              nvidia.com/gpu: "1"
              cpu: "1"
              memory: 8Gi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            runAsNonRoot: true
          volumeMounts:
            - name: weights
              mountPath: /weights
              readOnly: true
            - name: output
              mountPath: /out
            - name: dshm
              mountPath: /dev/shm
          startupProbe:
            # 모델 적재(수십 초~분 단위)가 끝나기 전에 liveness 가 재시작시키지
            # 않도록 넉넉히 둔다. 이 워커는 HTTP 서버가 아니라 SQS 폴링 루프라
            # 파일 존재로 헬스를 판단한다.
            exec:
              command: ["test", "-f", "/tmp/ready"]
            initialDelaySeconds: 10
            periodSeconds: 15
            failureThreshold: 40
      volumes:
        - name: weights
          persistentVolumeClaim:
            claimName: ${PROJECT_NAME}-wan-weights
            readOnly: true
        - name: output
          emptyDir:
            sizeLimit: 20Gi
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: 8Gi
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: video-worker
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: video-worker
    app.kubernetes.io/part-of: ${PROJECT_NAME}
  # Pod Identity 로 IAM 역할을 받는다(terraform/hub/40-video-gpu 가 연결을 만든다).
  # 액세스 키를 주입하지 않는다.
