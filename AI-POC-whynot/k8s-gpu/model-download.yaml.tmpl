# 모델 가중치 다운로드 Job.
#
# ## 왜 GPU 노드에서 돌리는가
#
# GPU 가 필요 없는 작업이다. 그런데 PVC 가 `WaitForFirstConsumer` 라서
# **이 Job 이 뜨는 노드의 AZ 에 EBS 볼륨이 만들어진다.** CPU 노드에서 돌리면
# 볼륨이 CPU 노드의 AZ 에 생기고, GPU 노드가 다른 AZ 면 워커가 영구 Pending 이 된다.
# g6e 는 ap-northeast-2a / 2b 에만 있고 CPU 노드그룹은 2a/2b/2c 를 쓴다.
#
# 비용은 다운로드 시간(20~40분) × $2.288/h ≒ $1~1.5 다. AZ 불일치로 하루를
# 날리는 것보다 싸다.
#
# ## 재실행이 안전하다
#
# 완료 마커를 두고, 있으면 즉시 끝낸다. 68GB 를 두 번 내려받지 않는다.
#
# ## hf_transfer 를 쓰는 이유
#
# 기본 다운로더로 68GB 를 받으면 훨씬 오래 걸린다. Rust 기반 병렬 전송을 쓴다.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${PROJECT_NAME}-wan-model-download
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: video-worker
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  # 3시간. 68GB 를 받는 데 그보다 오래 걸리면 무언가 잘못된 것이다.
  activeDeadlineSeconds: 10800
  backoffLimit: 2
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ${PROJECT_NAME}-wan-model-download
    spec:
      restartPolicy: OnFailure
      nodeSelector:
        ${GPU_NODE_LABEL_KEY}: ${GPU_NODE_LABEL_VALUE}
      tolerations:
        - key: nvidia.com/gpu
          operator: Equal
          value: "true"
          effect: NoSchedule
      containers:
        - name: download
          image: python:3.12-slim
          env:
            - name: HF_HUB_ENABLE_HF_TRANSFER
              value: "1"
            - name: HF_HOME
              value: /weights/hf-cache
            - name: MODEL_REPO
              value: ${WAN_MODEL_REPO}
            - name: TARGET_DIR
              value: /weights/${WAN_MODEL_DIR}
          resources:
            requests:
              cpu: 500m
              memory: 2Gi
            limits:
              # 병렬 전송이 메모리를 쓴다. g6e.xlarge 는 RAM 32GiB 뿐이므로
              # 8Gi 로 제한해 노드 전체가 압박받지 않게 한다.
              cpu: "3"
              memory: 8Gi
          volumeMounts:
            - name: weights
              mountPath: /weights
          command:
            - bash
            - -lc
            - |
              set -euo pipefail
              MARKER="$TARGET_DIR/.download-complete"

              if [ -f "$MARKER" ]; then
                echo "이미 내려받은 가중치가 있습니다. 건너뜁니다."
                du -sh "$TARGET_DIR"
                exit 0
              fi

              echo "=== 의존성 설치 ==="
              pip install --no-cache-dir --quiet 'huggingface_hub[hf_transfer]==0.35.3'

              echo "=== 다운로드 시작: $MODEL_REPO ==="
              date
              df -h /weights | tail -1

              python - <<'PY'
              import os
              from huggingface_hub import snapshot_download
              path = snapshot_download(
                  repo_id=os.environ["MODEL_REPO"],
                  local_dir=os.environ["TARGET_DIR"],
                  max_workers=8,
                  # 예시 영상과 이미지는 추론에 쓰지 않는다. 용량만 늘린다.
                  ignore_patterns=["assets/*", "examples/*", "nohup.out", "*.md"],
              )
              print("downloaded to", path)
              PY
              date

              echo "=== 검증 ==="
              # MoE 구조라 확산 모델이 둘이다. 각 6개 샤드가 있어야 한다.
              # 하나라도 빠지면 로드가 실패하는데, 그 시점은 GPU 가 켜진 뒤다.
              # 여기서 잡는 것이 싸다.
              for d in high_noise_model low_noise_model; do
                n=$(ls -1 "$TARGET_DIR/$d"/diffusion_pytorch_model-*.safetensors 2>/dev/null | wc -l)
                echo "$d 샤드: $n"
                [ "$n" -eq 6 ] || { echo "샤드가 6개가 아닙니다: $d"; exit 1; }
              done
              test -f "$TARGET_DIR/models_t5_umt5-xxl-enc-bf16.pth" || { echo "T5 인코더 없음"; exit 1; }
              test -f "$TARGET_DIR/Wan2.1_VAE.pth" || { echo "VAE 없음"; exit 1; }

              du -sh "$TARGET_DIR"
              df -h /weights | tail -1
              touch "$MARKER"
              echo "=== 완료 ==="
      volumes:
        - name: weights
          persistentVolumeClaim:
            claimName: ${PROJECT_NAME}-wan-weights
