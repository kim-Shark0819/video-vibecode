apiVersion: v1
kind: ConfigMap
metadata:
  name: ${FRONTEND_DEPLOYMENT_NAME}-runtime
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
    app.kubernetes.io/component: frontend
    app.kubernetes.io/part-of: ${PROJECT_NAME}
data:
  runtime-config.js: |
    window.__WHYNOT_RUNTIME__ = Object.freeze({ videoGen: ${VIDEO_GEN_ENABLED}, storyDev: ${STORY_DEV_ENABLED}, persistLogin: ${PERSIST_LOGIN} });
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${FRONTEND_DEPLOYMENT_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
    app.kubernetes.io/component: frontend
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
  template:
    metadata:
      annotations:
        whynot.meta-clouds.com/runtime-track-flags: "video=${VIDEO_GEN_ENABLED};story=${STORY_DEV_ENABLED};persistLogin=${PERSIST_LOGIN}"
      labels:
        app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
        app.kubernetes.io/component: frontend
        app.kubernetes.io/part-of: ${PROJECT_NAME}
    spec:
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
      containers:
        - name: frontend
          image: ${FRONTEND_IMAGE}
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8080
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: runtime-config
              mountPath: /usr/share/nginx/html/runtime-config.js
              subPath: runtime-config.js
              readOnly: true
            - name: nginx-cache
              mountPath: /var/cache/nginx
            - name: nginx-pid
              mountPath: /tmp
      volumes:
        - name: runtime-config
          configMap:
            name: ${FRONTEND_DEPLOYMENT_NAME}-runtime
        - name: nginx-cache
          emptyDir: {}
        - name: nginx-pid
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: ${FRONTEND_DEPLOYMENT_NAME}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: ${FRONTEND_DEPLOYMENT_NAME}
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${APP_SERVICE_ACCOUNT}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: ${APP_SERVICE_ACCOUNT}
    app.kubernetes.io/component: api
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ${APP_SERVICE_ACCOUNT}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ${APP_SERVICE_ACCOUNT}
        app.kubernetes.io/component: api
        app.kubernetes.io/part-of: ${PROJECT_NAME}
    spec:
      serviceAccountName: ${APP_SERVICE_ACCOUNT}
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: ${APP_SERVICE_ACCOUNT}
      containers:
        - name: app
          image: ${APP_IMAGE}
          imagePullPolicy: Always
          env:
            - name: AWS_REGION
              value: ${AWS_REGION}
            - name: S3_BUCKET
              value: ${S3_BUCKET}
            - name: S3_VIDEO_BUCKET
              value: ${S3_VIDEO_BUCKET}
            # 리전이 다른 provider 를 함께 두면 `output_bucket_for` 가 이 값에서
            # 맞는 리전 버킷을 고른다. 넘기지 않으면 빈 값이라 못 고른다 (실측).
            - name: S3_VIDEO_LEGACY_BUCKET
              value: ${S3_VIDEO_LEGACY_BUCKET}
            - name: NEPTUNE_ENDPOINT
              value: ${NEPTUNE_ENDPOINT}
            - name: NEPTUNE_PORT
              value: "${NEPTUNE_PORT}"
            # 회사 코드·시드 사용자·한도는 Secret ${AUTH_SECRET_NAME} 에서 읽는다.
            # 예전에는 config.env 값을 여기 직접 렌더링했다. 그러면 렌더 결과(workloads.yaml)에
            # 시드 사용자 비밀번호가 평문으로 들어가, ArgoCD 가 읽는 ai-deploy 저장소에 비밀값이
            # 커밋된다. Secret 으로 옮기면 렌더 결과에 비밀값이 없어 git 에 둘 수 있다.
            # Secret 의 키는 build-deploy.sh 가 config.env 값으로 만든다(수동 회전은 kubectl).
            - name: DEFAULT_COMPANY_CODE
              valueFrom:
                secretKeyRef:
                  name: ${AUTH_SECRET_NAME}
                  key: company-code
            # 결과물 생성 한도. 계정을 처음 만들 때의 초기값이고, 그 뒤로는 관리자 화면이
            # 최종 값이다(merge_user 가 coalesce 로 기존 값을 지킨다).
            - name: SEED_USERS
              valueFrom:
                secretKeyRef:
                  name: ${AUTH_SECRET_NAME}
                  key: seed-users
            - name: USER_QUOTAS
              valueFrom:
                secretKeyRef:
                  name: ${AUTH_SECRET_NAME}
                  key: user-quotas
            # 이미지 모델 리전은 영상 출력 리전과 독립이다. Stability 이미지 모델은
            # us-west-2에 있고, Nova Reel(LEGACY)의 us-east-1을 따라가면 모델 ID가
            # invalid로 거부된다.
            - name: COVER_IMAGE_REGION
              value: ${IMAGE_MODEL_REGION}
            # 영상 모델과 그 출력 버킷이 있는 리전. 서울에는 영상 모델이 없다.
            - name: VIDEO_OUTPUT_REGION
              value: ${VIDEO_OUTPUT_REGION}
            # 참고 이미지 상한. config.env 가 단일 원본이고 server.py 와 image_brief.py 가
            # 이 값을 각자 읽는다(서로 임포트하면 순환이 된다).
            - name: VIDEO_MAX_REFERENCE_IMAGES
              value: "${VIDEO_MAX_REFERENCE_IMAGES}"
            # --- Whynot PRD 9단계 개발 미리보기 ---
            # UI와 API 전환을 같은 값으로 묶어 한쪽만 열리는 상태를 막는다.
            - name: VIDEO_GEN_ENABLED
              value: "${VIDEO_GEN_ENABLED}"
            # 스토리 트랙은 기본 활성이고 배포별로 선택지를 끌 수 있다.
            - name: STORY_DEV_ENABLED
              value: "${STORY_DEV_ENABLED}"
            # --- vpoc1 영상 기능 (PRD 6.8) ---
            # VIDEO_GEN_ENABLED 가 꺼진 배포에서는 이 값과 무관하게 라우트가 없다.
            - name: VPOC_ENABLED
              value: "${VPOC_ENABLED}"
            # dev 에서만 AWS 오류 원문을 화면에 그대로 보인다. 운영 전환 때 false.
            - name: VPOC_RAW_ERRORS
              value: "${VPOC_RAW_ERRORS}"
            # 브라우저에서 영상 1건을 직접 만들어 보는 테스트 페이지. dev 전용.
            - name: VPOC_SMOKE_ENABLED
              value: "${VPOC_SMOKE_ENABLED}"
            - name: VPOC_TEXT_MODEL
              value: "${VPOC_TEXT_MODEL}"
            - name: VPOC_IMAGE_MODEL
              value: "${VPOC_IMAGE_MODEL}"
            - name: VPOC_IMAGE_REGION
              value: "${VPOC_IMAGE_REGION}"
            - name: VPOC_VIDEO_MODEL
              value: "${VPOC_VIDEO_MODEL}"
            - name: VPOC_VIDEO_REGION
              value: "${VPOC_VIDEO_REGION}"
            # Luma 출력 버킷. 모델과 **같은 리전**이어야 한다(문서가 꼽는 Failed 첫 원인).
            - name: VPOC_VIDEO_BUCKET
              value: "${VPOC_VIDEO_BUCKET}"
            - name: VPOC_RESOLUTION
              value: "${VPOC_RESOLUTION}"
            - name: VPOC_DURATION
              value: "${VPOC_DURATION}"
            - name: VPOC_ASPECT
              value: "${VPOC_ASPECT}"
            # 실측 쿼터: Luma Ray V2 on-demand 동시 요청 = 1. 올리면 Throttling 이 난다.
            - name: VPOC_MAX_INFLIGHT
              value: "${VPOC_MAX_INFLIGHT}"
            - name: VPOC_MAX_SHOTS
              value: "${VPOC_MAX_SHOTS}"
            # 비용 상한은 없다(2026-09-23 사용자 결정). 원장은 기록만 하고 제출을 막지 않는다.
            # 단가는 아래 두 값으로 계산한다.
            - name: VPOC_TEXT_USD_PER_MTOK_IN
              value: "${VPOC_TEXT_USD_PER_MTOK_IN}"
            - name: VPOC_TEXT_USD_PER_MTOK_OUT
              value: "${VPOC_TEXT_USD_PER_MTOK_OUT}"
            # ④단계 "이 샷만 의견 반영해 다시 만들기". false 면 새 액션 3개가 404 다.
            - name: VPOC_REGEN_ENABLED
              value: "${VPOC_REGEN_ENABLED}"
            # ② 영상 모델 고르기(dev 만). false 면 항상 Luma Ray2.
            - name: VPOC_MODEL_PICKER_ENABLED
              value: "${VPOC_MODEL_PICKER_ENABLED}"
            - name: VPOC_ARK_MODEL_2_0
              value: "${VPOC_ARK_MODEL_2_0}"
            - name: VPOC_ARK_MODEL_2_5
              value: "${VPOC_ARK_MODEL_2_5}"
            - name: VPOC_ARK_USD_PER_SEC_2_0
              value: "${VPOC_ARK_USD_PER_SEC_2_0}"
            - name: VPOC_ARK_USD_PER_SEC_2_5
              value: "${VPOC_ARK_USD_PER_SEC_2_5}"
            - name: VPOC_ARK_RESOLUTION
              value: "${VPOC_ARK_RESOLUTION}"
            # vpoc2 (명령 → 캐릭터 확정 → 15초 영상 → 리뷰). false 면 /api/vpoc2 가 없다.
            - name: VPOC2_ENABLED
              value: "${VPOC2_ENABLED}"
            # 외부 SaaS(Seedance) 경로. real 계약이 확정되기 전에는 mock 외 값을 허용하지 않는다.
            # **이야기 분석·기준 이미지와 같은 스위치가 아니다** — 아래 STORY_MODEL_MODE 를 본다.
            - name: PROVIDER_MODE
              value: "${PROVIDER_MODE}"
            # 이야기 분석·기준 이미지 역할이 우리 계정 Bedrock 을 실제로 부를지.
            # 계약 경계(PROVIDER_MODE)와 비용 스위치를 한 변수에 얹지 않는다.
            - name: STORY_MODEL_MODE
              value: "${STORY_MODEL_MODE}"
            # 법무 승인 전 원본·파생 웹툰 자산의 외부 provider 전송을 차단한다.
            - name: SEEDANCE_ALLOW_ORIGINAL_ASSETS
              value: "${SEEDANCE_ALLOW_ORIGINAL_ASSETS}"
            # --- Seedance 2.0 (AWS Marketplace SaaS · BytePlus ModelArk) ---
            #
            # **Bedrock 모델이 아니다.** 우리가 가진 것은 Marketplace 상품
            # `prod-vdri6kfaqizps` 의 SaaS 계약이고(License Manager 에서 AVAILABLE,
            # 2026-09-09~2026-10-09), 호출은 ModelArk 의 HTTPS API 로 나간다. 그래서
            # `bedrock list-foundation-models` 에 안 보이는 것이 정상이다.
            #
            # 실측: 이 네 값이 매니페스트에 없어서 코드 기본값(stub · test_only)이 그대로
            # 적용되고 있었다. 값을 바꿀 자리를 만들어 둔다.
            - name: SEEDANCE_MODE
              value: "${SEEDANCE_MODE}"
            - name: ARK_BASE_URL
              value: "${ARK_BASE_URL}"
            - name: ARK_MODEL_ID
              value: "${ARK_MODEL_ID}"
            - name: VENDOR_INPUT_POLICY
              value: "${VENDOR_INPUT_POLICY}"
            # 벤더 API 키. **인증 Secret 과 섞지 않는다.** 아직 없으면 Secret 자체가 없고
            # optional 이라 파드는 그대로 뜬다 — 그때는 코드가 live 제출을 거부한다.
            - name: ARK_API_KEY
              valueFrom:
                secretKeyRef:
                  name: ${SEEDANCE_SECRET_NAME}
                  key: ark-api-key
                  optional: true
            # fal.ai API 키(설계자 2026-10-18). ARK_API_KEY 와 같은 모양 — 아직 Secret 이 없으면
            # optional 이라 파드는 그대로 뜨고, 그때는 ② 모델 고르기에서 fal 이 "fal API 키 미설정"
            # 으로 보이고 카탈로그/등록 API 가 409 를 돌려준다.
            - name: FAL_KEY
              valueFrom:
                secretKeyRef:
                  name: ${FAL_SECRET_NAME}
                  key: fal-api-key
                  optional: true
            # 요청 본문 스키마를 공식 문서로 확인했는가. 확인 전에는 live 제출을 막는다.
            - name: SEEDANCE_SCHEMA_VERIFIED
              value: "${SEEDANCE_SCHEMA_VERIFIED}"
            # 계약 조건. 사용자가 주기 전에는 비어 있고, 비면 금액·토큰을 계산하지 않는다.
            - name: SEEDANCE_CONTRACT_TOKEN_TOTAL
              value: "${SEEDANCE_CONTRACT_TOKEN_TOTAL}"
            - name: SEEDANCE_CONTRACT_TOKEN_RATES
              value: "${SEEDANCE_CONTRACT_TOKEN_RATES}"
            - name: SEEDANCE_CONTRACT_ENDS_AT
              value: "${SEEDANCE_CONTRACT_ENDS_AT}"
            # --- 장면 영상화 provider (spec: scene-video-aws-only) ---
            #
            # 이 네 값이 "어떤 경로로 영상이 만들어지는가" 를 정한다. 코드 기본값에
            # 의존하지 않고 매니페스트에서 명시한다 — 이전에 SEEDANCE_MODE 를 주입하지
            # 않아 코드 기본값(stub)이 운영에 그대로 적용되어, 사용자에게 파란 단색
            # 화면이 "생성 완료" 로 나가던 문제가 있었다.
            - name: SCENE_VIDEO_PROVIDER
              value: ${SCENE_VIDEO_PROVIDER}
            - name: SCENE_VIDEO_ALLOWED_PROVIDERS
              value: ${SCENE_VIDEO_ALLOWED_PROVIDERS}
            # 운영에서 반드시 false. true 면 자리표시자가 결과물로 나간다(D-A04).
            - name: SCENE_VIDEO_ALLOW_STUB
              value: "${SCENE_VIDEO_ALLOW_STUB}"
            # 자체 GPU 경로의 서버측 스위치. UI 숨김만으로는 API 직접 호출을 막지 못한다.
            - name: SCENE_VIDEO_GPU_ENABLED
              value: "${SCENE_VIDEO_GPU_ENABLED}"
            - name: SCENE_VIDEO_VERIFICATION_TTL_SECONDS
              value: "${SCENE_VIDEO_VERIFICATION_TTL_SECONDS}"
            # 계정 고정 가드. 이 값과 다른 계정에서 기동되면 기능 라우트를 모두 거부한다.
            - name: EXPECTED_ACCOUNT_ID
              value: "${AWS_ACCOUNT_ID}"
            - name: MODEL_CATALOG_PATH
              value: ${MODEL_CATALOG_PATH}
            - name: MODEL_CONFIG_KEY
              value: ${MODEL_CONFIG_KEY}
            # vpoc1(2026-09-23): 자체 GPU 추론 서버(Wan 2.2 I2V) 주소를 지웠다. 그 경로의
            # 코드가 사라졌고 GPU 노드도 두지 않는다. 다시 들여오려면 k8s-gpu/ 와 함께 되돌린다.
            - name: ADMIN_USERNAME
              valueFrom:
                secretKeyRef:
                  name: ${AUTH_SECRET_NAME}
                  key: username
            - name: ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ${AUTH_SECRET_NAME}
                  key: password
            - name: TOKEN_SECRET
              valueFrom:
                secretKeyRef:
                  name: ${AUTH_SECRET_NAME}
                  key: token-secret
          ports:
            - name: http
              containerPort: 8000
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: model-catalog
              mountPath: ${MODEL_CATALOG_DIR}
              readOnly: true
      volumes:
        - name: tmp
          emptyDir: {}
        - name: model-catalog
          configMap:
            name: ${MODEL_CATALOG_CONFIGMAP}
            items:
              - key: models.json
                path: models.json
---
apiVersion: v1
kind: Service
metadata:
  name: ${APP_SERVICE_ACCOUNT}
  namespace: ${K8S_NAMESPACE}
  labels:
    app.kubernetes.io/name: ${APP_SERVICE_ACCOUNT}
    app.kubernetes.io/part-of: ${PROJECT_NAME}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: ${APP_SERVICE_ACCOUNT}
  ports:
    - name: http
      port: 8000
      targetPort: http
