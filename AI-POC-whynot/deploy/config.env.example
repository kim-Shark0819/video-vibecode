# AI-POC 환경 설정 견본
#
# 실물 config.env 는 저장소에 없다. 내장 계정 비밀번호가 평문으로 들어가기 때문이다.
# 클론한 뒤 이 파일을 복사해서 값을 채운다.
#
#   Copy-Item AI-POC/deploy/config.env.example AI-POC/deploy/config.env
#
# <...> 로 표시된 값만 채우면 된다. 나머지는 현재 계정의 실값이다.
#
# **이 파일은 CI 의 렌더 원본이기도 하다.** .gitlab-ci.yml 의 deploy:ai-poc 잡이 이 파일 +
# config.prod.env 로 k8s/*.tmpl 을 렌더링해 ai-deploy 저장소에 커밋하고 ArgoCD 가 배포한다.
# 그래서 비밀값이 아닌 실값은 여기에 있어야 한다(비어 있으면 CI 렌더 결과에도 비어 있다).
# 비밀값(ADMIN_PASSWORD, SEED_USERS, DEFAULT_COMPANY_CODE)은 템플릿이 참조하지 않고
# Secret(AUTH_SECRET_NAME)의 키로 클러스터에만 있다.
#
# 형식: KEY=VALUE (따옴표 없이, 주석은 #)
# 주의: PowerShell 의 Get-Content/Set-Content 로 이 파일을 편집하지 말 것.
#       기본 ANSI 해석이 한글 주석 뒤 줄바꿈을 삼켜 다음 줄의 KEY=VALUE 가 주석에 합쳐진다.

# --- 계정 / 리전 ---
AWS_ACCOUNT_ID=730335451955
AWS_REGION=ap-northeast-2
# 이미지를 가져올 ECR 계정. 비우면 AWS_ACCOUNT_ID 를 쓴다(개발계는 비운다).
# 고객사 운영 배포에서만 채운다 — 앱은 고객 계정에서 돌고 이미지는 우리 계정 ECR 에서 당겨온다.
ECR_ACCOUNT_ID=

# 자격증명 JSON 경로 (워크스페이스 루트 기준). 액세스 키가 평문이라 이 파일도 저장소에 없다.
CREDENTIALS_FILE=통합계정.json
# accounts_list 에서 이 access_name 을 찾아 쓴다. 인덱스로 고르지 않는다.
# 항목 순서가 바뀌면 조용히 다른 계정의 키를 집어 들기 때문이다.
CREDENTIALS_ACCESS_NAME=kiro-iam-mtx

# --- EKS ---
#
# ## 클러스터별 오버레이
#
# 대상마다 다른 값은 deploy/config.<target>.env 에 두고 이 파일 위에 덮어쓴다.
# 그 파일은 비밀값이 없어 저장소에 추적된다.
#
#   EKS_CLUSTER_NAME  EKS_OIDC_ID  EKS_CLUSTER_SECURITY_GROUP
#   IAM_APP_ROLE_NAME  IAM_APP_POLICY_NAME  ALB_NAME
#   NEPTUNE_ENDPOINT  NEPTUNE_CLUSTER_ID  NEPTUNE_SECURITY_GROUP  APP_DOMAIN
#
# 현재 대상은 하나다.
#
#   powershell -File AI-POC/deploy/deploy.ps1            # prod 가 기본값
#   powershell -File AI-POC/deploy/deploy.ps1 -Target prod
#
# **dev 대상은 제거했다.** `Dev-AI-POC-eks` 를 삭제해서 배포할 곳이 없다.
# 구조를 남기는 이유: 값을 클러스터별로 분리하지 않은 것이 이 파이프라인의 버그
# (호출부와 build-deploy.sh 의 필수값 목록이 어긋난 것)를 만든 원인이었고,
# Phase 5 의 고객사별 배포에서 같은 구조가 다시 필요하다.
#
# 아래 값은 오버레이가 없을 때 쓰이는 기본값이다.
EKS_CLUSTER_NAME=AI-POC-eks
# aws eks describe-cluster --query cluster.identity.oidc.issuer 의 마지막 경로 값
EKS_OIDC_ID=2A49105728911261AD4F240BFD9A8AB1
EKS_CLUSTER_SECURITY_GROUP=sg-022e24e853dfdc241
# EKS API 가 프라이빗 전용이라 이 배스천을 통해 kubectl 을 실행한다.
BASTION_INSTANCE_ID=i-0ca57a18e69b73a1f

# --- 네트워크 ---
VPC_ID=vpc-0de9ff1693bd56f38
PUBLIC_SUBNET_IDS=subnet-0b8b4832085705b56,subnet-07db8faf09bcfcdbb,subnet-053f2f798359b197a
PRIVATE_SUBNET_IDS=subnet-01e0e91f3c43b57f2,subnet-071250e072cc06c64,subnet-0ac1a0b3cf1fb3c1f

# --- DNS / TLS ---
# 세 값이 비어 있으면 Ingress 가 80 리스너만 만든다. 도메인이 생기면 채운다.
# k8s/ingress.yaml.tmpl 에 되돌릴 세 줄이 주석으로 적혀 있다.
APP_DOMAIN=dev-whynot.meta-clouds.com
ROUTE53_HOSTED_ZONE_ID=Z0217882389GDS0BZDMYR
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:730335451955:certificate/9fd7fdac-7ed2-45e4-a810-6399803da5e4

# --- 스토리지 ---
S3_BUCKET=whynot-730335451955
# Bedrock 영상 모델은 서울에 없다. 비동기 출력 버킷은 모델과 같은 리전이어야 한다.
#
# `terraform/hub/28-whynot` 이 만든다(2026-09-15 apply: 1 imported · 7 added ·
# 1 changed · 0 destroyed). 같은 레이어가 `whynot-s3-access` 를 관리로 가져와
# v2 에 이 버킷 ARN 을 넣었다 — 그전에는 `RestrictToProjectBucketsOnly` 의
# `Deny s3:*` 가 이 버킷 호출을 전부 막고 있었다.
#
# **AI-POC 의 버킷을 공유하지 않는 이유.** provider 출력 prefix 기본값이
# `_smoke/<provider>/shot-<n>`(`bedrock_luma.py:253`)이라 테넌트 키가 없다.
# 고객 둘이 같은 버킷에 쓰면 같은 키를 덮어쓴다. 수명주기 규칙도 `users/` ·
# `_smoke/` prefix 를 전제한다.
# active 출력 버킷. 2026-09-19 에 us-west-2 에서 us-east-1 로 옮겼다 — Reel 전환(B3) 때문이다.
# 비동기 출력은 **모델과 같은 리전의 버킷만** 받으므로 provider 리전과 반드시 짝이다.
# 개발계 provider 는 Luma(us-west-2)다. Bedrock 비동기 출력은 **모델과 같은 리전의
# 버킷만** 받으므로 이 값이 provider 리전과 함께 움직여야 한다. us-east-1 은 Nova Reel
# 시절 값이고 지금은 legacy 다 (실측: readiness 의 버킷 판정이 계속 실패해 영상 제출이
# blockedBy=["environment"] 로 막혔다).
S3_VIDEO_BUCKET=whynot-video-730335451955-us-west-2
# 이전 active 였던 두 번째 출력 버킷. 기존 결과물이 여기 있어 **읽기로 남긴다.**
# `render.py` 가 비면 위 버킷으로 대체하므로, 비우면 옛 결과물을 못 읽는다.
S3_VIDEO_LEGACY_BUCKET=whynot-video-730335451955-us-east-1
# 두 번째 버킷에 쓰기를 줄지. 새 생성은 active 로만 나간다.
S3_VIDEO_LEGACY_WRITABLE=false
VIDEO_OUTPUT_REGION=us-west-2
# 텍스트→기준 이미지 생성 모델은 영상 모델과 독립적으로 호출한다.
# `model-catalog` 의 Stability 모델과 `COVER_IMAGE_REGION` 에 함께 주입된다.
# 이 키가 없으면 영상 리전 설정을 따라가 Stability 모델 ID 가 invalid 로 거부된다.
IMAGE_MODEL_REGION=us-west-2
# 한 요청에 쓸 수 있는 참고 이미지 수. 20 이 기술 상한이다(Bedrock Converse 가
# 요청당 이미지 20장까지만 받는다). 이 값이 단일 원본이다.
VIDEO_MAX_REFERENCE_IMAGES=20

# --- 장면 영상화 provider (scene_video) ---
#
# `k8s/workloads.yaml.tmpl` 이 이 키들을 `${...}` 로 참조한다. 키가 없으면
# CI 의 미치환 검사에 걸려 deploy:whynot:dev 가 실패한다.
#
# **AI-POC 와 같아졌다(2026-09-19).** AI-POC 는 실측으로 active 를 Reel(us-east-1) +
# 애니 키프레임 조합으로 바꿨다 — 카메라 고정과 인물 동작을 동시에 만족한 유일한
# 조합이고, Luma 는 네 구성 모두 카메라를 잡지 못해 신규 생성에서 제외했다.
# whynot 도 이제 같은 조합이다. 전제였던 두 가지를 B3 에서 만들었다.
#   - 버킷 `whynot-video-730335451955-us-east-1` (us-east-1, AI-POC 버킷과 공유하지 않는다)
#   - `whynot-s3-access` v3 — 새 버킷 Allow 3문장 + RestrictToProjectBucketsOnly Deny 완화
# 둘 다 CLI 로 직접 만들었고 Terraform 편입은 후속 작업이다.
# 기록: docs/run-log/story-video-rebuild/aws-direct-changes.md
#
# 기본 provider. 허용 목록 안에 있어야 한다.
#
# 개발계를 Luma Ray2 로 옮긴다. 두 가지 이유다.
#
#   1. Nova Reel v1.1 은 LEGACY 이고 EOL 이 2026-09-30 이다. 남은 기간이 짧다.
#   2. 프롬프트 한도가 512 → 5,000자다. Reel 의 512자 때문에 인물 특징·행동·카메라를
#      담다가 잘려 나갔다. 그 압축이 품질을 깎는 가장 큰 원인이었다.
#
# 출력 버킷은 `providers.output_bucket_for` 가 리전으로 고른다. us-west-2 버킷이
# `S3_VIDEO_LEGACY_BUCKET` 에 이미 있으므로 Luma(us-west-2)가 맞는 것을 받는다.
# 이미 만들어진 Nova Reel 결과는 실행 기록에 `outputBucket` 이 남아 그대로 읽힌다.
SCENE_VIDEO_PROVIDER=bedrock_luma
# 허용 목록(쉼표). 여기 없는 이름을 요청하면 거부된다 — 오타나 실험용 경로가
# 운영에 켜지는 것을 설정 단계에서 막는다.
SCENE_VIDEO_ALLOWED_PROVIDERS=bedrock_luma,bedrock_reel
# 자리표시자(단색 카드) 허용 여부. **운영에서는 반드시 false 다**(D-A04).
# true 로 두면 "생성 완료"라고 표시된 파란 화면이 사용자에게 나간다.
SCENE_VIDEO_ALLOW_STUB=false
# 자체 GPU(Wan 2.2) 경로. 서버측 스위치다 — UI 숨김만으로는 API 직접 호출을 막지 못한다.
# 이 디렉터리는 GPU 를 이관하지 않았으므로 false 다.
SCENE_VIDEO_GPU_ENABLED=false
# 같은 provider/model/region/bucket/source revision 의 최근 성공을 준비 완료로 인정하는 기간.
# 기간이 지나도 readiness 가 유료 호출을 자동 실행하지는 않고 unverified 로 표시한다.
SCENE_VIDEO_VERIFICATION_TTL_SECONDS=604800

# --- Neptune (그래프: 사용자/프로젝트) ---
# 아직 만들지 않았다. 인프라가 생성한 뒤 실제 엔드포인트로 갱신한다(docs/새-고객-추가.md §4 예상값).
# 없으면 로그인과 프로젝트가 동작하지 않는다.
NEPTUNE_ENDPOINT=whynot-graph.cluster-cd0q2kk4wlbo.ap-northeast-2.neptune.amazonaws.com
NEPTUNE_PORT=8182
NEPTUNE_CLUSTER_ID=whynot-graph
NEPTUNE_SECURITY_GROUP=sg-05401ae26d7660ee5
# 회원가입 시 요구되는 회사 고유 코드의 초기값. 이후 관리자가 화면에서 변경한다.
DEFAULT_COMPANY_CODE=<회사코드>
# 내장 계정. 이 값이 단일 원본이며 기동할 때마다 비밀번호를 여기에 맞춘다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<관리자비밀번호>
# 내장 일반 사용자 (username:password 쉼표 구분)
SEED_USERS=<사용자1:비밀번호1,사용자2:비밀번호2>
# 결과물 생성 한도. `사용자:video=건수,asset=건수` 이고 사용자끼리는 세미콜론으로 나눈다.
# 비어 있으면 전원 무제한. 계정을 처음 만들 때만 적용되고 그 뒤로는 관리자 화면이 최종 값이다.
USER_QUOTAS=

# --- 컨테이너 이미지 ---
ECR_FRONTEND_REPO=whynot-frontend
ECR_APP_REPO=whynot-app
# GPU 노드를 두지 않기로 해서 Wan 2.2 추론 서버는 이관하지 않았다. 비워 둔다.
ECR_VIDEO_GEN_REPO=
VIDEO_GEN_TAG=
# ECR 태그가 immutable 이라 같은 태그로 재푸시할 수 없다. 새 배포는 새 태그를 쓴다.
IMAGE_TAG=<YYYYMMDD-vN>

# --- GPU 영상 워커 (config.prod.env 가 실값을 덮어쓴다. 여기서는 키만 둔다) ---
# render.py 는 오버레이에만 있는 키를 거절하므로 config.env 에 키가 있어야 한다.
GPU_NODEGROUP_NAME=ai-poc-video-gpu-4xl
VIDEO_WORKER_REPO=dev-ai-poc-video-worker
VIDEO_WORKER_TAG=wan22-v11
VIDEO_CLIP_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/730335451955/whynot-video-clip
# k8s-gpu/*.tmpl 이 참조한다. GPU 노드가 없는 대상에서도 render.py 가 전체 템플릿을 렌더링하므로 키가 있어야 한다.
# GPU 노드그룹 ai-poc-video-gpu-4xl 은 ai-poc 와 공유한다(label workload=video-gpu, taint nvidia.com/gpu).
# max 1 이라 두 앱이 동시에 GPU 를 쓸 수는 없다. 평소 desired 0 이라 비용은 나지 않는다.
GPU_NODE_LABEL_KEY=workload
GPU_NODE_LABEL_VALUE=video-gpu
# k8s-gpu 의 나머지 참조 키. GPU 를 쓰는 대상에서 config.<target>.env 가 실값을 준다.
MODEL_PVC_SIZE=200Gi
WAN_MODEL_DIR=Wan2.2-I2V-A14B
WAN_MODEL_REPO=Wan-AI/Wan2.2-I2V-A14B

# --- Bedrock 모델 카탈로그 ---
MODEL_CATALOG_CONFIGMAP=whynot-models
MODEL_CATALOG_DIR=/etc/ai-poc
MODEL_CATALOG_PATH=/etc/ai-poc/models.json
MODEL_CONFIG_KEY=_config/models.json

# --- Kubernetes / IAM 이름 ---
K8S_NAMESPACE=whynot
APP_SERVICE_ACCOUNT=whynot-app
FRONTEND_DEPLOYMENT_NAME=whynot-frontend
AUTH_SECRET_NAME=whynot-auth
PROJECT_NAME=whynot
# 아래 세 값은 클러스터별 오버레이가 덮어쓴다 (위 "클러스터별 오버레이" 참고).
IAM_APP_ROLE_NAME=whynot-app-role
IAM_APP_POLICY_NAME=whynot-s3-access
# Ingress 의 alb.ingress.kubernetes.io/load-balancer-name 이 되는 값.
# 두 클러스터가 같은 이름을 쓰면 양쪽 컨트롤러가 같은 ALB 를 서로 고쳐 쓴다.
ALB_NAME=whynot-web-alb

# --- 배포 경로 ---
# argocd 이면 deploy.ps1 이 거부한다. 배포는 main 푸시 -> CI -> ArgoCD. (config.<target>.env 가 정한다)
DEPLOY_MANAGED_BY=argocd

# --- Whynot PRD 9단계 개발 미리보기 ---
# frontend와 backend를 같은 값으로 게이트한다. 운영 overlay는 false로 덮어쓴다.
VIDEO_GEN_ENABLED=true
# 스토리 개발 트랙. 기본 true이고 환경별로 영상 트랙과 독립적으로 끌 수 있다.
STORY_DEV_ENABLED=true
# 로그인 유지. true 이면 토큰을 localStorage 에도 두어 새 창·새 탭에서 다시 로그인하지 않는다.
# 만료는 서버 TOKEN_TTL_SECONDS 그대로다. 기본 false(탭마다 로그인), 운영 overlay 만 켠다(설계자 2026-10-07).
PERSIST_LOGIN=false
# --- 1단계 텍스트·로그 입력 확장 (텍스트 입력 확장 PRD §10.5) ---
# 두 스위치를 따로 둔다. 입력은 열어 두고 미검증 생성만 막을 수 있어야 한다.
#
# preview     1단계에 "캐릭터와 글로 만들기" 를 노출하고 초안 저장·복원을 허용한다.
#             저장·모드 전환·조회에 모델 호출이 없다.
# generation  텍스트 방식에서 **유료 생성**(계획 승인의 기준 이미지 · I2V)을 허용한다.
#             꺼져 있으면 서버가 409 로 거부한다. 화면을 숨기는 것으로 대신하지 않는다.
#             실영상 품질 검증을 통과한 뒤에 켠다. **웹툰 방식은 이 값과 무관하다.**
STORY_TEXT_INPUT_PREVIEW=true
STORY_TEXT_INPUT_GENERATION=true
# 새 legacy root·파괴 작업은 막고 기존 ID의 승인·취소·검수·재부착은 유지한다.
LEGACY_VIDEO_WRITE_MODE=drain
# live IAM에 전역 `_cache/video-analysis/` 권한을 추가하기 전까지 mock 분석은 cache 없이 실행한다.
VIDEO_ANALYSIS_CACHE_ENABLED=false
# 외부 SaaS(Seedance) 경로. 실제 계약이 확정되기 전에는 mock만 허용한다.
# **이야기 분석·기준 이미지 스위치가 아니다** — 아래 STORY_MODEL_MODE 가 그 자리다.
PROVIDER_MODE=mock
# 이야기 분석(video.story_understanding)·기준 이미지(video.keyframe_ref)가 우리 계정
# Bedrock 을 실제로 부를지. 개발계는 real 이다.
#
# PROVIDER_MODE 와 나눈 이유: 그 값은 "외부 vendor 계약이 없다" 는 뜻이고 seedance_client
# 가 읽는다. 두 뜻을 한 변수에 얹어 두면 계정 안의 Bedrock 호출 하나를 켜려고 외부 vendor
# 경로까지 함께 켜야 한다. 개발계의 다른 트랙(스토리·표지)은 이미 Bedrock 을 real 로
# 부르고 있어, 영상 분석만 mock 으로 남아 있는 것이 오히려 어긋난 상태였다.
#
# 운영 오버레이(config.prod.env)는 mock 으로 덮어쓴다. 운영은 VIDEO_GEN_ENABLED=false 라
# 영상 트랙 자체가 노출되지 않는다.
STORY_MODEL_MODE=real
# 법무 승인 전에는 원본·파생 웹툰 자산을 외부 provider로 보내지 않는다.
SEEDANCE_ALLOW_ORIGINAL_ASSETS=false

# --- 장면 영상화 (scene_video, Seedance 2.0) ---
# 붙였다 뗄 수 있는 독립 기능. app/src/scene_video/config.py 가 이 값을 읽는다.
# **아직 k8s/workloads.yaml.tmpl 은 이 값을 참조하지 않는다** — Phase 0(벤더 실측)이
# 끝나 API 키가 나오면 workloads.yaml.tmpl 에 env 항목으로 추가하고 여기 값을 채운다.
# 그 전까지는 코드 기본값(SEEDANCE_MODE=stub)이 그대로 적용되어 벤더를 호출하지 않는다.
# Seedance 2.0 은 **Bedrock 모델이 아니다.** AWS Marketplace SaaS 상품
# `prod-vdri6kfaqizps` 이고 호출은 BytePlus ModelArk 의 HTTPS API 로 나간다. 계약은
# License Manager 에 있다 (`aws license-manager list-received-licenses`).
#
# 상품 페이지가 밝힌 능력: 길이 4~15초 · 해상도 480P/720P/1080P/4K · 토큰 차감형
# (해상도·입력 방식에 따라 최대 약 1:1.8 차이) · 프라이빗 오퍼라 공개 단가 없음.
SEEDANCE_MODE=stub
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL_ID=dreamina-seedance-2-0-260128
ARK_MODEL_ID_FAST=dreamina-seedance-2-0-fast-260128
# 벤더 API 키를 담을 k8s Secret 이름. **이 파일에 키 값을 적지 않는다.**
SEEDANCE_SECRET_NAME=seedance-api-key
# 공식 API 본문 스키마를 확인했는가. false 면 코드가 live 제출을 거부한다.
SEEDANCE_SCHEMA_VERIFIED=false
# 계약 조건. 비면 금액·토큰을 계산하지 않는다 (단가를 추정하지 않는다).
SEEDANCE_CONTRACT_TOKEN_TOTAL=
SEEDANCE_CONTRACT_TOKEN_RATES=
SEEDANCE_CONTRACT_ENDS_AT=2026-10-09
# k8s Secret(예: seedance-api-key)의 키로 주입한다. config.env 에 실값을 적지 않는다.
ARK_API_KEY=
# 원본 웹툰 이미지 외부 전송 정책. 서면 승인 전에는 test_only 를 유지한다(D-S06).
VENDOR_INPUT_POLICY=test_only

# --- vpoc1 영상 기능 (PRD 6.8) ---
# 정본: AI-POC-whynot/docs/vpoc1/PRD.md. VIDEO_GEN_ENABLED 가 꺼지면 이 값과 무관하게 꺼진다.
VPOC_ENABLED=true
# dev 에서만 AWS 오류 원문을 화면에 그대로 보인다(D-L06). 운영 전환 때 false.
VPOC_RAW_ERRORS=true
# 브라우저에서 영상 1건을 직접 만들어 보는 테스트 페이지(/vpoc-smoke.html). dev 전용.
VPOC_SMOKE_ENABLED=true
VPOC_TEXT_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
VPOC_IMAGE_MODEL=stability.sd3-5-large-v1:0
VPOC_IMAGE_REGION=us-west-2
VPOC_VIDEO_MODEL=luma.ray-v2:0
VPOC_VIDEO_REGION=us-west-2
# Luma 출력 버킷. 모델과 같은 리전이어야 한다. Gate 0 C6 에서 확인했다.
VPOC_VIDEO_BUCKET=whynot-video-730335451955-us-west-2
VPOC_RESOLUTION=540p
VPOC_DURATION=5s
VPOC_ASPECT=16:9
# 실측(2026-09-23 Gate 0 C8): Luma Ray V2 on-demand 동시 요청 쿼터 = 1.
# 2 이상으로 올리면 ThrottlingException 이 나고 샷이 queued 로 되돌아간다.
VPOC_MAX_INFLIGHT=1
VPOC_MAX_SHOTS=6
# 비용 상한은 없다(2026-09-23 사용자 결정, 지원 금액 8,000 USD).
# 원장은 기록만 하고 제출을 막지 않는다. 화면은 누적 금액만 보인다.
VPOC_TEXT_USD_PER_MTOK_IN=3
VPOC_TEXT_USD_PER_MTOK_OUT=15
# ④단계 "이 샷만 의견 반영해 다시 만들기"(regen-plan G6).
# 문제가 생기면 이 값만 false 로 바꿔 배포하면 새 액션 3개가 404 가 되고 화면 버튼도 사라진다.
VPOC_REGEN_ENABLED=true
# ② 영상 모델 고르기 — Luma Ray2 · Seedance 2.0 · 2.5 (설계자 2026-10-07, dev 만. mini·fast 는 뺐다).
# 기본 false(운영은 이 값 그대로 꺼진다). 고객 계정 dev 매니페스트에서만 true 로 켠다.
# Seedance 는 ARK_API_KEY(Secret seedance-api-key) 가 있어야 고를 수 있다. 모델 ID 가 빈 모델은 화면에 "미설정".
VPOC_MODEL_PICKER_ENABLED=false
VPOC_ARK_MODEL_2_0=dreamina-seedance-2-0-260128
VPOC_ARK_MODEL_2_5=dreamina-seedance-2-5-260628
# 생성 1초 USD 덮어쓰기. 비면 vpoc/settings.py 의 단가표(콘솔 견적에서 계산, 해상도별)를 쓴다.
VPOC_ARK_USD_PER_SEC_2_0=
VPOC_ARK_USD_PER_SEC_2_5=
VPOC_ARK_RESOLUTION=720p

# --- vpoc2 영상 기능 (2026-09-30) ---
# 명령 → 캐릭터 확정 → 15초(5초 × 3샷) → 리뷰. /vpoc2.html · /api/vpoc2.
# 주 버킷은 S3_BUCKET, 영상 버킷은 VPOC_VIDEO_BUCKET 을 같이 쓴다(접두사 users/*/video/_vpoc2/).
# 문제가 생기면 이 값만 false 로 바꿔 배포하면 /api/vpoc2 가 사라진다. vpoc1 에는 영향이 없다.
VPOC2_ENABLED=true
